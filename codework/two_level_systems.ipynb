   "source": [
    "# Basis states\n",
    "r = [0; 1]  # Assume |1>\n",
    "g = [1; 0]  # Assume |0>\n",
    "\n",
    "#Initial state\n",
    "ρ0 = kron(g,g) * kron(g,g)'\n",
    "\n",
    "t_vals = 0.0 :1: 2*(Δ0+p(0)[2])/δ # Define time range\n",
    "E = []\n",
    "Delta = []\n",
    "\n",
    "for t in t_vals\n",
    "    #2x2 Matrices\n",
    "    σ_x = [0 1; 1 0]\n",
    "    n = [0 0; 0 1]\n",
    "    I = [1 0; 0 1]\n",
    "    #parameters\n",
    "    Ω, V_nn, Δ_t = p(t)\n",
    "\n",
    "    #Hamiltonian\n",
    "    H = Ω/2 .* kron(I,σ_x) + Δ_t .* kron(I,n) - V_nn .* kron(n,n)\n",
    "    eigenvals = eigvals(H,sortby=nothing)\n",
    "    print(eigenvals[2])\n",
    "    push!(E, eigenvals)\n",
    "    push!(Delta, Δ_t)\n",
    "end"
   ]
